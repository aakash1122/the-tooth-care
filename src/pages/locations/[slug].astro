---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import Photo from "../../components/Photo.astro";
import ContactClose from "../../components/ContactClose.astro";
import { branches, practice } from "../../data/clinic";

export function getStaticPaths() {
  return branches.map((branch) => ({ params: { slug: branch.slug }, props: { branch } }));
}

const { branch } = Astro.props;
const other = branches.find((candidate) => candidate.slug !== branch.slug)!;
const title = `${branch.name} chamber - ${practice.fullName}`;
const description = `${practice.fullName}, ${branch.name} chamber: ${branch.address}. Phone ${branch.phone.display}. ${practice.hours.summary}.`;
---

<Base title={title} description={description}>
  <PageIntro title={`${branch.name} chamber`} lead={branch.landmark} />

  <section class="section" aria-labelledby="find">
    <div class="wrap">
      <div class="details">
        <div>
          <h2 id="find" class="h2">
            Finding us
          </h2>
          <address>{branch.address}</address>
          <dl>
            <dt>Phone</dt>
            <dd>
              <a href={`tel:${branch.phone.tel}`}>{branch.phone.display}</a>
            </dd>
            <dt>Hours</dt>
            <dd>
              {practice.hours.summary}{" "}
              {practice.hours.openingToConfirm && (
                <span class="todo">(opening time to confirm)</span>
              )}
            </dd>
            <dt>Parking</dt>
            <dd>
              {branch.parking} <span class="todo">(street or lot, to confirm)</span>
            </dd>
            <dt>Map</dt>
            <dd>
              <a class="link" href={branch.mapsUrl} rel="noopener">
                Open in Google Maps
              </a>
            </dd>
          </dl>
          <p class="other">
            Our other chamber is in{" "}
            <a class="link" href={`/locations/${other.slug}`}>
              {other.name}
            </a>
            . Both offer the same treatments.
          </p>
        </div>
        <Photo
          class="door"
          alt={`a photo of the ${branch.name} front door`}
          brief="The front door, so you recognise it"
        />
      </div>
    </div>
  </section>

  <ContactClose
    title={`Appointments in ${branch.name}`}
    text={`Message us on WhatsApp or call ${branch.phone.display}. We reply during chamber hours, every day until ${practice.hours.closing}.`}
    intent="appointment"
  />
</Base>

<style>
  .details {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 900px) {
    .details {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }
  address {
    margin-top: 18px;
    line-height: 1.5;
    max-width: 30em;
  }
  dl {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 8px 14px;
    font-size: 15.5px;
    margin: 22px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }
  dt {
    color: var(--ink-soft);
  }
  dd {
    margin: 0;
  }
  dd a[href^="tel:"] {
    font-weight: 600;
  }
  .other {
    margin-top: 28px;
    color: var(--ink-soft);
    max-width: 36em;
  }
  .details :global(.door) {
    aspect-ratio: 16 / 10;
  }
</style>
