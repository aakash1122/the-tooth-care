---
/** Navy closing panel with WhatsApp and one call link per chamber. Shared by every page. */
import WhatsAppButton from "./WhatsAppButton.astro";
import { branches, practice } from "../data/clinic";
import type { WhatsAppIntent } from "../lib/whatsapp";

interface Props {
  title?: string;
  text?: string;
  intent?: WhatsAppIntent;
}
const {
  title = "Questions or appointments",
  text = `Message us on WhatsApp or call either chamber. We reply during chamber hours, every day until ${practice.hours.closing}.`,
  intent = "question",
} = Astro.props;
---

<section class="section close on-navy" aria-labelledby="ask">
  <div class="wrap">
    <h2 id="ask" class="h2">
      {title}
    </h2>
    <p>{text}</p>
    <div class="actions">
      <WhatsAppButton intent={intent} />
      {branches.map((branch) => (
        <a class="btn btn-quiet" href={`tel:${branch.phone.tel}`}>
          Call {branch.name} {branch.phone.display}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .close {
    background: var(--navy);
    color: var(--panel);
  }
  .close h2 {
    color: var(--panel);
    max-width: 18ch;
  }
  .close p {
    color: var(--ink-on-navy-soft);
    max-width: 36em;
    margin-top: 16px;
  }
  .actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
</style>
