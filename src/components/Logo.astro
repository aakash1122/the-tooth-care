---
/**
 * Stand-in wordmark. The real logo (bold serif wordmark, blue tooth outline,
 * italic "By Dr. Uzzal") replaces the SVG and text here once the clinic supplies it.
 */
import { practice } from "../data/clinic";
---

<a class="logo" href="/" aria-label={`${practice.fullName}, home`}>
  <svg
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linejoin="round"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M15 6c4 0 6 2.5 9 2.5S29 6 33 6c5.5 0 9 4.5 9 10 0 5-3 7.5-4 13-1 5-1.5 13-5 13-3.5 0-3.5-9-9-9s-5.5 9-9 9c-3.5 0-4-8-5-13C9 23.5 6 21 6 16 6 10.5 9.5 6 15 6Z"></path>
  </svg>
  <span>
    <b>{practice.name}</b>
    <i>{practice.byline}</i>
  </span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--navy);
  }
  .logo svg {
    width: 34px;
    height: 34px;
  }
  .logo b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 21px;
    letter-spacing: 0.005em;
    line-height: 1;
    display: block;
  }
  .logo i {
    display: block;
    font-family: var(--font-text);
    font-size: 13px;
    font-style: italic;
    color: var(--ink-soft);
    margin-top: 3px;
  }
</style>
