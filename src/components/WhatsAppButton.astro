---
/**
 * Every WhatsApp action goes through /whatsapp so the number can change in KV
 * without a redeploy. See functions/whatsapp.ts.
 */
import type { HTMLAttributes } from "astro/types";
import { whatsAppPath, type WhatsAppIntent } from "../lib/whatsapp";

interface Props extends Omit<HTMLAttributes<"a">, "href" | "rel"> {
  intent?: WhatsAppIntent;
  icon?: boolean;
}

const { intent = "appointment", icon = false, class: className, ...rest } = Astro.props;
---

<a
  class:list={["btn", "btn-primary", className]}
  href={whatsAppPath(intent)}
  rel="noopener"
  {...rest}
>
  {icon && (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4.5 19.5 5.6 15.7A8.5 8.5 0 1 1 8.6 18.6Z" />
      <path d="M9.2 9.1c.2 2.6 2.4 4.8 5.1 5.4l1.3-1.3-1.9-.9-.9.7c-1-.4-1.9-1.3-2.3-2.3l.7-.9-.9-1.9Z" />
    </svg>
  )}
  <slot>Message us on WhatsApp</slot>
</a>
